      },
      "content": {
        "contentAbove": "<h2>How a loaf is made</h2>",
        "buttons": [],
        "items": [
          {
            "title": "Feed the starter",
            "content": "<p>The starter is fed twice a day so it is at its peak when the dough is mixed.</p>",
            "media": null
          },
          {
            "title": "Mix and fold",
            "content": "<p>Flour, water, salt and starter are mixed, then folded by hand over three hours.</p>",
            "media": null
          },
          {
            "title": "Cold ferment",
            "content": "<p>Shaped loaves rest in the cooler for a day and a half, which builds flavor.</p>",
            "media": null
          },
          {
            "title": "Bake hot",
            "content": "<p>Each loaf is baked in a steam-injected deck oven until the crust is deep brown.</p>",
            "media": null
          }
        ]
      },
      "media": null
    }
