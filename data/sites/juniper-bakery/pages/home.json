      "content": {
        "contentAbove": "<h2>Before you visit</h2>",
        "items": [
          {
            "question": "When is the bread ready?",
            "answer": "<p>Loaves are on the shelves at 7 a.m. Tuesday through Sunday. Popular loaves sell out by late morning, so order ahead if you need one later.</p>"
          },
          {
            "question": "Can I order ahead?",
            "answer": "<p>Yes. Call the shop by 3 p.m. and we will hold your order for pickup the next day.</p>"
          },
          {
            "question": "Do you bake gluten-free bread?",
            "answer": "<p>No. Flour is everywhere in our kitchen, so we cannot promise anything is free of gluten.</p>"
          }
        ]
      },
